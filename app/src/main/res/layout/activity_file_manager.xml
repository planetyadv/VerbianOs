<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:paddingStart="36dp"
    android:paddingEnd="36dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TV File Manager &amp; APK Installer"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="← Back"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:focusable="true"
            android:clickable="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/btn_pill_selector" />

    </RelativeLayout>

    <!-- Quick Storage Drive Switchers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_storage_internal"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="📁 Internal Storage"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:background="@drawable/btn_pill_selector"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginEnd="12dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_storage_usb"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="🔌 USB Drive"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:background="@drawable/btn_pill_selector"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginEnd="12dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_storage_downloads"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="⬇️ Downloads / APKs"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:background="@drawable/btn_pill_selector"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true" />

    </LinearLayout>

    <!-- Current Path Breadcrumb -->
    <TextView
        android:id="@+id/tv_current_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/focus_border_light"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp"
        tools:text="/storage/emulated/0/Download" />

    <!-- File List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

</LinearLayout>
