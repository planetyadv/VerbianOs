<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_gradient"
    android:baselineAligned="false">

    <!-- Left Sidebar / Dock -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="92dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sidebar"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Sidebar item: YouTube Quick Launch -->
        <LinearLayout
            android:id="@+id/btn_side_youtube"
            android:layout_width="74dp"
            android:layout_height="64dp"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/sidebar_item_selector"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_youtube"
                android:contentDescription="YouTube" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube"
                android:textColor="@color/text_white"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Sidebar item: Lite Web Browser -->
        <LinearLayout
            android:id="@+id/btn_side_browser"
            android:layout_width="74dp"
            android:layout_height="64dp"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/sidebar_item_selector"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_browser"
                android:contentDescription="Web" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Web Lite"
                android:textColor="@color/text_white"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Sidebar item: TV File Manager & USB -->
        <LinearLayout
            android:id="@+id/btn_side_files"
            android:layout_width="74dp"
            android:layout_height="64dp"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/sidebar_item_selector"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_folder"
                android:contentDescription="Files" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Files &amp; USB"
                android:textColor="@color/text_white"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Sidebar item: RAM Turbo Boost -->
        <LinearLayout
            android:id="@+id/btn_side_boost"
            android:layout_width="74dp"
            android:layout_height="64dp"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/sidebar_item_selector"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_ram_boost"
                android:contentDescription="Boost" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Boost RAM"
                android:textColor="@color/text_white"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Sidebar item: All Apps -->
        <LinearLayout
            android:id="@+id/btn_side_apps"
            android:layout_width="74dp"
            android:layout_height="64dp"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/sidebar_item_selector"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_apps"
                android:contentDescription="All Apps" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apps"
                android:textColor="@color/text_white"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Sidebar item: Settings -->
        <LinearLayout
            android:id="@+id/btn_side_settings"
            android:layout_width="74dp"
            android:layout_height="64dp"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/sidebar_item_selector">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="Settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <!-- Top Header: Title + RAM info + Clock -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recently_used"
                android:textColor="@color/text_white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_ram_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#00E676"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="20dp"
                    android:text="⚡ 60 FPS | Low RAM" />

                <TextView
                    android:id="@+id/tv_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="18:30" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Horizontal List of Recent Items / Shortcuts -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recents"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:orientation="horizontal" />

        <!-- Bottom Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btn_see_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_all_apps"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/btn_pill_selector" />

            <Button
                android:id="@+id/btn_add_web"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_web_shortcut"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:layout_marginStart="16dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/btn_pill_selector" />

            <Button
                android:id="@+id/btn_open_files"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📁 Files / USB"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:layout_marginStart="16dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/btn_pill_selector" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
